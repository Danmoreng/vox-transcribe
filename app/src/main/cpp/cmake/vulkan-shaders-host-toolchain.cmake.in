set(CMAKE_BUILD_TYPE Release)
set(CMAKE_C_FLAGS -O2)
set(CMAKE_CXX_FLAGS -O2)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER)
set(CMAKE_MAKE_PROGRAM "@VOX_CMAKE_MAKE_PROGRAM@" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER "@VOX_HOST_C_COMPILER@")
set(CMAKE_CXX_COMPILER "@VOX_HOST_CXX_COMPILER@")
set(CMAKE_LINKER "@VOX_HOST_LINKER@" CACHE FILEPATH "" FORCE)
set(CMAKE_RC_COMPILER "@VOX_HOST_RC_COMPILER@" CACHE FILEPATH "" FORCE)
set(CMAKE_MT "@VOX_HOST_MT@" CACHE FILEPATH "" FORCE)
set(CMAKE_EXE_LINKER_FLAGS "/LIBPATH:\"@VOX_HOST_MSVC_LIB@\" /LIBPATH:\"@VOX_HOST_WINSDK_UM_LIB@\" /LIBPATH:\"@VOX_HOST_WINSDK_UCRT_LIB@\"")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "@VOX_HOST_RUNTIME_OUTPUT_DIRECTORY@")
